# Autonomous Underwriting Engine Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Groq LLM Inference (Sub-100ms Llama-3.1-8b)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.1-8b-instant"

# Telemetry & Observability
LOGFIRE_TOKEN="your_logfire_token_here"
LOGFIRE_PROJECT_NAME="autonomous-underwriting-engine"

# LangSmith Tracing (Optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="autonomous-underwriting-engine"

# Redis Cache (Optional)
REDIS_URL="redis://localhost:6379/0"
USE_REDIS=false

# Mesh API (System 1 Jev Evaluation via typesafe/jev-1.13)
MESH_API_KEY="your_mesh_api_key_here"
MESH_BASE_URL="https://api.meshapi.ai/v1"
JEV_MODEL="typesafe/jev-1.13"
